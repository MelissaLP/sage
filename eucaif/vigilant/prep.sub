# HTCondor: one part of the Vigilant glitches (prep.py run), a node of OUT/vigilant.dag, in the SAGE container
# (sage_cpu.def). Don't submit this directly: `prep.py dag` writes the DAG, which sets repo, csv, out, chunk, part,
# acct (accounting group), commit, image and disk (GB).
#
# The job gets SAGE's sage/ package, prep.py and the CSV in its sandbox, reads the frames at CIT (datafind with
# the job's SciToken) and sends parts/ back to OUT/parts/.

universe              = container
container_image       = $(image)
executable            = /opt/conda/envs/sage/bin/python
transfer_executable   = False
arguments             = "prep.py run $Fnx(csv) . --chunk $(chunk) --part $(part)"
environment           = "OMP_NUM_THREADS=1 SAGE_COMMIT=$(commit) GWDATAFIND_SERVER=datafind.ldas.cit:80"

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = $(repo)/sage, $(repo)/eucaif/vigilant/prep.py, $(csv)
transfer_output_files   = parts
initialdir              = $(out)

use_oauth_services = scitokens
# Frames: read at CIT, where datafind and the archive are
+DESIRED_Sites     = "LIGO-CIT"
requirements       = (Arch == "X86_64")

output         = $(out)/logs/part_$(part).out
error          = $(out)/logs/part_$(part).err
log            = $(out)/logs/vigilant.log
request_cpus   = 1
request_memory = 4 GB
request_disk   = $(disk) GB
accounting_group      = $(acct)
accounting_group_user = $ENV(USER)
queue
