# HTCondor: one part of the glitches (prep.py run), node part<k> of OUT/vigilant.dag, in the SAGE container
# (sage_cpu.def). Written for the DAG: `prep.py dag` sets repo, csv, out, chunk, part, image, acct (accounting
# group), commit and disk (GB).
#
# in:  SAGE's sage/, prep.py, the CSV                  out: parts/ -> OUT/parts/virgo_glitches_partNNN_{median,welch}.h5

universe              = container
container_image       = $(image)
executable            = /opt/conda/envs/sage/bin/python
transfer_executable   = False
arguments             = "prep.py run $Fnx(csv) . --chunk $(chunk) --part $(part)"
environment           = "OMP_NUM_THREADS=1 SAGE_COMMIT=$(commit) GWDATAFIND_SERVER=datafind.igwn.org"

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = $(repo)/sage, $(repo)/eucaif/vigilant/prep.py, $(csv)
transfer_output_files   = parts
initialdir              = $(out)

use_oauth_services          = scitokens
scitokens_oauth_permissions = read:/virgo gwdatafind.read
# h(t): gwpy's TimeSeries.get asks GWDATAFIND_SERVER for the files and reads them, with the job's token
requirements       = (Arch == "X86_64")

output         = $(out)/logs/part_$(part).out
error          = $(out)/logs/part_$(part).err
log            = $(out)/logs/vigilant.log
request_cpus   = 1
request_memory = 4 GB
request_disk   = $(disk) GB
accounting_group      = $(acct)
accounting_group_user = $ENV(USER)
queue
